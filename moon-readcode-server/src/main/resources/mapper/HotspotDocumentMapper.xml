<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luckymoon.moon_readcode_server.mapper.HotspotDocumentMapper">

    <resultMap id="BaseResultMap" type="com.luckymoon.moon_readcode_server.entity.HotspotDocument">
        <id column="id" property="id"/>
        <result column="project_id" property="projectId"/>
        <result column="topic_id" property="topicId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, project_id, topic_id, title, content, status, create_time, update_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO hotspot_document (project_id, topic_id, title, content, status, create_time, update_time)
        VALUES (#{projectId}, #{topicId}, #{title}, #{content}, #{status}, NOW(), NOW())
    </insert>

    <update id="updateById">
        UPDATE hotspot_document
        SET title = #{title},
            content = #{content},
            status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM hotspot_document WHERE id = #{id}
    </select>

    <select id="selectByTopicId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM hotspot_document WHERE topic_id = #{topicId}
        LIMIT 1
    </select>

    <select id="selectByProjectId" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM hotspot_document WHERE project_id = #{projectId}
        ORDER BY create_time DESC
    </select>

</mapper>
