<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.luckymoon.moon_readcode_server.mapper.CodeFileMapper">

    <resultMap id="BaseResultMap" type="com.luckymoon.moon_readcode_server.entity.CodeFile">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_type" property="fileType"/>
        <result column="content" property="content"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, file_name, file_path, file_type, content, create_time, update_time
    </sql>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM code_file
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM code_file
        WHERE id = #{id}
    </select>

    <select id="selectByFilePath" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM code_file
        WHERE file_path LIKE CONCAT('%', #{filePath}, '%')
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO code_file (file_name, file_path, file_type, content, create_time, update_time)
        VALUES (#{fileName}, #{filePath}, #{fileType}, #{content}, NOW(), NOW())
    </insert>

    <update id="updateById">
        UPDATE code_file
        SET file_name = #{fileName},
            file_path = #{filePath},
            file_type = #{fileType},
            content = #{content},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM code_file
        WHERE id = #{id}
    </delete>

</mapper>
