# ============================================================
# 环境变量模板 —— 复制为 .env 后填入你自己的值
# ============================================================

# 要分析的目标项目路径（宿主机上的绝对路径）
PILOT_TARGET_PROJECT=/path/to/your/java/project

# LLM 提供商：ollama（本地免费）/ dashscope（通义千问）
# PILOT_LLM_PROVIDER=ollama

# 如果用 dashscope，填你的 API Key
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 如果 Ollama 跑在宿主机（Mac 推荐），一般不用改
# PILOT_LLM_API_BASE=http://host.docker.internal:11434/v1

# 聊天模型（默认 qwen2.5:7b）
# PILOT_LLM_CHAT_MODEL=qwen2.5:7b

# Embedding 模型（默认 bge-m3，1024 维）
# PILOT_LLM_EMBEDDING_MODEL=bge-m3

# 向量维度（必须与 embedding 模型对齐）
# PILOT_VECTOR_DIMENSION=1024
